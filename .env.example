# Runtime environment: development, staging or production.
APP_ENV=development

# Optional OpenAI-compatible chat completions provider.
# Keep real credentials in your hosting provider's secret manager, never in Git.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# AI provider request timeout; allowed range is 1-120 seconds.
AI_TIMEOUT_SECONDS=25

# Comma-separated frontend origins in production. "*" is for local development only.
ALLOWED_ORIGINS=*

# Read-only admin review queue. Generate a random secret of at least 32 characters.
# Keep it only in the hosting provider's secret manager; never commit the real value.
ADMIN_API_TOKEN=
