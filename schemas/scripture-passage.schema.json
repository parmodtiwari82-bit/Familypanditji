{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Scripture Passage and Edition-Aware Citation",
 "description":"A passage is traceable to one exact edition and its native locator. Schema validity does not prove textual authenticity.",
 "type":"object","additionalProperties":false,
 "required":["passage_id","source_id","edition_id","locator","language","script","original_text","transcription"],
 "properties":{
  "passage_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]+$"},
  "source_id":{"type":"string","minLength":1},
  "edition_id":{"type":"string","minLength":1},
  "locator":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"enum":["kanda","mandala","ashtaka","adhyaya","sarga","skandha","chapter","section","hymn","sukta","verse","mantra","pada","folio","page","other"]},"value":{"type":"string","minLength":1}}}},
  "language":{"type":"string","minLength":1},
  "script":{"type":"string","minLength":1},
  "original_text":{"type":"string","minLength":1},
  "transcription":{"type":"object","additionalProperties":false,"required":["method","status"],"properties":{
   "method":{"enum":["human_transcription","ocr","born_digital","unknown"]},
   "status":{"enum":["unreviewed","machine_checked","automated_validated","manually_corrected"]},
   "tool_name":{"type":"string"},"tool_version":{"type":"string"},
   "confidence":{"type":"number","minimum":0,"maximum":1},
   "ingested_at":{"type":"string","format":"date-time"},"checksum_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
  }},
  "translations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["translation_id","language","text","translator_or_source"],"properties":{
   "translation_id":{"type":"string","minLength":1},"language":{"type":"string","minLength":1},
   "text":{"type":"string","minLength":1},"translator_or_source":{"type":"string","minLength":1},
   "publication_or_edition":{"type":"string"},"rights_status":{"enum":["unknown","public_domain","open_licence","permission_granted","restricted","not_for_redistribution"]},
   "rights_evidence":{"type":"string"}
  }}},
  "notes":{"type":"string"}
 }
}
