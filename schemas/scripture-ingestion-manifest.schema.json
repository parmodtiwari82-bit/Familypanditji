{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Pandit Ji Scripture Ingestion Manifest",
  "description": "Artifact provenance metadata; does not establish source authenticity or legal rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "source_id",
          "edition_id",
          "artifact_type",
          "storage_ref",
          "acquired_at",
          "acquisition_method",
          "sha256",
          "extraction_method",
          "extraction_tool",
          "extraction_tool_version",
          "language",
          "script",
          "structural_location"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "edition_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "enum": [
              "scan",
              "digital_text",
              "transcription",
              "ocr_output"
            ]
          },
          "storage_ref": {
            "type": "string",
            "minLength": 1
          },
          "acquired_at": {
            "type": "string",
            "format": "date-time"
          },
          "acquisition_method": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "extraction_method": {
            "enum": [
              "none",
              "manual_transcription",
              "ocr",
              "publisher_text"
            ]
          },
          "extraction_tool": {
            "type": "string",
            "minLength": 1
          },
          "extraction_tool_version": {
            "type": "string",
            "minLength": 1
          },
          "ocr_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "structural_location": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}\n