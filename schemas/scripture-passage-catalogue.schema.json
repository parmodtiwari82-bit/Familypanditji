{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Pandit Ji Scripture Passage Catalogue",
  "description": "Edition-specific extracted passages. A passage is usable only when its source, edition and acquired artifact resolve and rights permit use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogue_version", "passages"],
  "properties": {
    "catalogue_version": {"const": "1.0.0"},
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passage_id", "source_id", "edition_id", "artifact_id", "work_title", "location", "text_original", "language", "script", "extraction_confidence"],
        "properties": {
          "passage_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "edition_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "work_title": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "text_original": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "script": {"type": "string", "minLength": 1},
          "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "keywords": {"type": "string"}
        }
      }
    }
  }
}
